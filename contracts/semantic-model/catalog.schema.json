{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2s:semantic-model:catalog:1.0.0:semantic-fact-model-1",
  "title": "C2S Semantic Model Catalog Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "types",
    "predicates"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "profile": {
      "enum": [
        "m1-project-discovery-1",
        "semantic-fact-model-1"
      ]
    },
    "types": {
      "$ref": "#/$defs/types"
    },
    "predicates": {
      "$ref": "#/$defs/predicates"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profile",
        "types",
        "enums"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "profile": {
          "enum": [
            "m1-project-discovery-1",
            "semantic-fact-model-1"
          ]
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeDefinition"
          }
        },
        "enums": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "typeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeId",
        "fields",
        "invariants"
      ],
      "properties": {
        "typeId": {
          "$ref": "#/$defs/id"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/fieldDefinition"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "predicates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profile",
        "predicates"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "profile": {
          "enum": [
            "m1-project-discovery-1",
            "semantic-fact-model-1"
          ]
        },
        "predicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicateId",
        "category",
        "primaryLayer",
        "description",
        "relationKind",
        "claimCardinality",
        "comparisonPolicy",
        "claimModes",
        "roles",
        "constraints"
      ],
      "properties": {
        "predicateId": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "Semantic",
            "Provenance"
          ]
        },
        "primaryLayer": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            null
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "relationKind": {
          "enum": [
            "attribute",
            "composition",
            "association"
          ]
        },
        "claimCardinality": {
          "enum": [
            "single_value_per_context",
            "multi_value"
          ]
        },
        "comparisonPolicy": {
          "enum": [
            "same_claim_mode_only",
            "never"
          ]
        },
        "claimModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "declaration",
              "specification",
              "static_may",
              "static_must",
              "observation",
              "interpretation"
            ]
          }
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "position",
        "valueType",
        "allowedKinds",
        "cardinality"
      ],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "enum": [
            "subject",
            "value"
          ]
        },
        "valueType": {
          "$ref": "#/$defs/id"
        },
        "allowedKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "Project",
              "PackageSpecification",
              "NativeWorkspace",
              "SourceDeclaration",
              "BehaviorBody",
              "BehaviorRegion",
              "BehaviorStep",
              "BuildTarget",
              "BuildRecipe",
              "BuildAlias",
              "OutputSpecification",
              "ArtifactObservation",
              "Binding",
              "AlgorithmDescription",
              "PseudocodeView",
              "Signature",
              "AccessConstraint",
              "CoordinationGroup",
              "UsageRequirement",
              "EntryPoint",
              "BuildTask",
              "DependencyRequirement",
              "DependencyProvider"
            ]
          }
        },
        "cardinality": {
          "const": "exactly_one"
        }
      }
    }
  }
}
