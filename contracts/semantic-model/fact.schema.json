{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2s:semantic-model:fact:1.0.0:m1-project-discovery-1",
  "title": "C2S M1 Semantic Fact Bundle",
  "description": "Structural contract for the bounded M1 project discovery slice; structural validity does not prove source truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "registrations", "assessments", "facts", "evidence", "coverage", "diagnostics"],
  "properties": {
    "version": {"const": "1.0.0"},
    "profile": {"const": "m1-project-discovery-1"},
    "registrations": {"type": "array", "items": {"$ref": "#/$defs/registration"}},
    "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1, "description": "Root-relative path preserving case and Unicode."},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "domainId", "localId"],
      "properties": {"authority": {"$ref": "#/$defs/id"}, "domainId": {"$ref": "#/$defs/id"}, "localId": {"$ref": "#/$defs/id"}}
    },
    "subjectRef": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "kind"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["Project", "PackageSpecification", "NativeWorkspace", "SourceDeclaration"]}
      }
    },
    "registration": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sourceKey", "evidenceIds"],
      "properties": {"ref": {"$ref": "#/$defs/subjectRef"}, "sourceKey": {"$ref": "#/$defs/id"},
        "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "mediaType", "sha256", "content"],
      "properties": {"artifactId": {"$ref": "#/$defs/id"}, "mediaType": {"const": "application/json"},
        "sha256": {"$ref": "#/$defs/sha256"}, "content": {"type": "string"}}
    },
    "evidence": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
          "required": ["evidenceId", "source", "path", "artifactId", "originalPath", "sha256", "startByte", "endByte", "method", "toolName", "toolVersion"],
          "properties": {"evidenceId": {"$ref": "#/$defs/id"}, "source": {"const": "input"}, "path": {"$ref": "#/$defs/path"},
            "artifactId": {"type": "null"}, "originalPath": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
            "startByte": {"type": "integer", "minimum": 0}, "endByte": {"type": "integer", "minimum": 0},
            "method": {"$ref": "#/$defs/id"}, "toolName": {"type": ["string", "null"]}, "toolVersion": {"type": ["string", "null"]}}
        },
        {"type": "object", "additionalProperties": false,
          "required": ["evidenceId", "source", "path", "artifactId", "originalPath", "sha256", "startByte", "endByte", "method", "toolName", "toolVersion"],
          "properties": {"evidenceId": {"$ref": "#/$defs/id"}, "source": {"const": "tool_output"}, "path": {"type": "null"},
            "artifactId": {"$ref": "#/$defs/id"}, "originalPath": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
            "startByte": {"type": "integer", "minimum": 0}, "endByte": {"type": "integer", "minimum": 0},
            "method": {"$ref": "#/$defs/id"}, "toolName": {"type": ["string", "null"]}, "toolVersion": {"type": ["string", "null"]}}
        }
      ]
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "recordId", "path", "message"],
      "properties": {"code": {"$ref": "#/$defs/id"}, "severity": {"enum": ["error", "gap", "conflict", "info"]},
        "recordId": {"type": ["string", "null"]}, "path": {"type": ["string", "null"]}, "message": {"type": "string", "minLength": 1}}
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["assessmentId", "declaration", "status", "projects", "ruleId", "evidenceIds", "supersedes", "diagnostics"],
      "properties": {"assessmentId": {"$ref": "#/$defs/id"}, "declaration": {"$ref": "#/$defs/subjectRef"},
        "status": {"enum": ["resolved", "ambiguous", "unresolved"]}, "projects": {"type": "array", "items": {"$ref": "#/$defs/subjectRef"}},
        "ruleId": {"$ref": "#/$defs/id"}, "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}}
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["factId", "predicate", "subject", "value", "claimMode", "condition", "evidenceIds"],
      "properties": {"factId": {"$ref": "#/$defs/id"}, "predicate": {"$ref": "#/$defs/id"}, "subject": {"$ref": "#/$defs/subjectRef"},
        "value": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/subjectRef"}]},
        "claimMode": {"enum": ["declaration", "interpretation"]}, "condition": {"type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": {"kind": {"const": "true"}}},
        "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["coverageId", "selector", "subject", "checkedPaths", "evidenceIds", "complete", "supersedes", "resolvedDiagnosticKeys", "diagnostics"],
      "properties": {"coverageId": {"$ref": "#/$defs/id"}, "selector": {"type": "string", "minLength": 1},
        "subject": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/subjectRef"}]},
        "checkedPaths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "complete": {"type": "boolean"},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "resolvedDiagnosticKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}}
    }
  }
}
