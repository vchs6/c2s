{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2s:semantic-model:fact:1.0.0:m1-project-discovery-1",
  "title": "C2S Semantic Fact Bundle",
  "description": "Structural contract for M1 project discovery and the initial context-aware semantic model; validity does not prove source truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "registrations",
    "assessments",
    "facts",
    "evidence",
    "coverage",
    "diagnostics"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "profile": {
      "enum": [
        "m1-project-discovery-1",
        "semantic-fact-model-1"
      ]
    },
    "registrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registration"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "dependencyResolutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyResolution"
      }
    },
    "semanticStates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semanticState"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "contextDomains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextDomain"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Root-relative path preserving case and Unicode."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "domainId",
        "localId"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/id"
        },
        "domainId": {
          "$ref": "#/$defs/id"
        },
        "localId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "subjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "kind": {
          "enum": [
            "Project",
            "PackageSpecification",
            "NativeWorkspace",
            "SourceDeclaration",
            "BehaviorBody",
            "BehaviorRegion",
            "BehaviorStep",
            "BuildTarget",
            "BuildRecipe",
            "BuildAlias",
            "OutputSpecification",
            "ArtifactObservation",
            "Binding",
            "AlgorithmDescription",
            "PseudocodeView",
            "Signature",
            "AccessConstraint"
          ]
        },
        "contextRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sourceKey",
        "evidenceIds"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/subjectRef"
        },
        "sourceKey": {
          "$ref": "#/$defs/id"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "mediaType",
        "sha256",
        "content"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/id"
        },
        "mediaType": {
          "const": "application/json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "source",
            "path",
            "artifactId",
            "originalPath",
            "sha256",
            "startByte",
            "endByte",
            "method",
            "toolName",
            "toolVersion"
          ],
          "properties": {
            "evidenceId": {
              "$ref": "#/$defs/id"
            },
            "source": {
              "const": "input"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "artifactId": {
              "type": "null"
            },
            "originalPath": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "startByte": {
              "type": "integer",
              "minimum": 0
            },
            "endByte": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "$ref": "#/$defs/id"
            },
            "toolName": {
              "type": [
                "string",
                "null"
              ]
            },
            "toolVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId",
            "source",
            "path",
            "artifactId",
            "originalPath",
            "sha256",
            "startByte",
            "endByte",
            "method",
            "toolName",
            "toolVersion"
          ],
          "properties": {
            "evidenceId": {
              "$ref": "#/$defs/id"
            },
            "source": {
              "const": "tool_output"
            },
            "path": {
              "type": "null"
            },
            "artifactId": {
              "$ref": "#/$defs/id"
            },
            "originalPath": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "startByte": {
              "type": "integer",
              "minimum": 0
            },
            "endByte": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "$ref": "#/$defs/id"
            },
            "toolName": {
              "type": [
                "string",
                "null"
              ]
            },
            "toolVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "recordId",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "enum": [
            "error",
            "gap",
            "conflict",
            "info"
          ]
        },
        "recordId": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessmentId",
        "declaration",
        "status",
        "projects",
        "ruleId",
        "evidenceIds",
        "supersedes",
        "diagnostics"
      ],
      "properties": {
        "assessmentId": {
          "$ref": "#/$defs/id"
        },
        "declaration": {
          "$ref": "#/$defs/subjectRef"
        },
        "status": {
          "enum": [
            "resolved",
            "ambiguous",
            "unresolved"
          ]
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subjectRef"
          }
        },
        "ruleId": {
          "$ref": "#/$defs/id"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "predicate",
        "subject",
        "value",
        "claimMode",
        "condition",
        "evidenceIds"
      ],
      "properties": {
        "factId": {
          "$ref": "#/$defs/id"
        },
        "predicate": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "$ref": "#/$defs/subjectRef"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/subjectRef"
            }
          ]
        },
        "claimMode": {
          "enum": [
            "declaration",
            "specification",
            "static_may",
            "static_must",
            "observation",
            "interpretation"
          ]
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "negativeBasis": {
          "$ref": "#/$defs/negativeBasis"
        },
        "sourceMetadata": {
          "$ref": "#/$defs/sourceMetadata"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "role"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "Supports",
            "Refutes",
            "Limits"
          ]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "premiseFactIds"
      ],
      "properties": {
        "ruleId": {
          "$ref": "#/$defs/id"
        },
        "premiseFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "negativeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "scope",
        "condition",
        "inputIds",
        "results",
        "humanReviewed",
        "unresolvedGapIds"
      ],
      "properties": {
        "method": {
          "enum": [
            "enumerated_input_membership",
            "registered_catalog_membership"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "inputIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputId",
              "matched"
            ],
            "properties": {
              "inputId": {
                "$ref": "#/$defs/id"
              },
              "matched": {
                "type": "boolean"
              }
            }
          }
        },
        "humanReviewed": {
          "type": "boolean"
        },
        "unresolvedGapIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "layer",
        "owner",
        "text",
        "evidenceIncluded"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "evidenceIncluded": {
          "type": "boolean"
        }
      }
    },
    "contextDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "values"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/id"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "assignments"
      ],
      "properties": {
        "contextId": {
          "$ref": "#/$defs/id"
        },
        "assignments": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyId",
        "consumer",
        "purpose",
        "stage",
        "path",
        "version",
        "condition",
        "evidenceIds"
      ],
      "properties": {
        "dependencyId": {
          "$ref": "#/$defs/id"
        },
        "consumer": {
          "$ref": "#/$defs/subjectRef"
        },
        "purpose": {
          "enum": [
            "build",
            "runtime",
            "development",
            "test",
            "optional"
          ]
        },
        "stage": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "dependencyResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolutionId",
        "dependencyId",
        "status",
        "providers",
        "configuration",
        "visibility",
        "scopePosition",
        "evidenceIds"
      ],
      "properties": {
        "resolutionId": {
          "$ref": "#/$defs/id"
        },
        "dependencyId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "resolved",
            "ambiguous",
            "unresolved"
          ]
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subjectRef"
          }
        },
        "configuration": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopePosition": {
          "enum": [
            "inside",
            "outside",
            "unknown"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "semanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateId",
        "selector",
        "subject",
        "predicate",
        "condition",
        "presentation",
        "acquisition",
        "factIds",
        "applicabilityReason",
        "evidenceIds",
        "diagnostics"
      ],
      "properties": {
        "stateId": {
          "$ref": "#/$defs/id"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/subjectRef"
            }
          ]
        },
        "predicate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "presentation": {
          "enum": [
            "ref_only",
            "expanded"
          ]
        },
        "acquisition": {
          "enum": [
            "obtained",
            "not_acquired",
            "unsupported",
            "not_applicable"
          ]
        },
        "factIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "applicabilityReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "true",
                "false"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "eq",
                "neq"
              ]
            },
            "key": {
              "$ref": "#/$defs/id"
            },
            "value": {
              "type": [
                "string",
                "boolean"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "conditions"
          ],
          "properties": {
            "kind": {
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "condition"
          ],
          "properties": {
            "kind": {
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expression"
          ],
          "properties": {
            "kind": {
              "const": "source"
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverageId",
        "selector",
        "subject",
        "checkedPaths",
        "evidenceIds",
        "complete",
        "supersedes",
        "resolvedDiagnosticKeys",
        "diagnostics"
      ],
      "properties": {
        "coverageId": {
          "$ref": "#/$defs/id"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/subjectRef"
            }
          ]
        },
        "checkedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "resolvedDiagnosticKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    }
  }
}
