{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2s:semantic-fact-query:0.5.0",
  "title": "C2S Semantic Fact Query Result",
  "description": "One bounded request projection. complete covers the requested supported selectors, not whole-project E0-E4 semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "requested", "complete", "coverage", "source_digest", "profile_digest", "persistence", "tools_used", "facts", "gaps", "inventory"],
  "properties": {
    "root": {"type": "string", "minLength": 1},
    "requested": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "complete": {"type": "boolean"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tools_used": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "diagnostic"],
      "properties": {
        "status": {"enum": ["not_requested", "cache_hit", "saved", "saved_after_read_failure", "write_failed", "read_write_failed"]},
        "diagnostic": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["source_files", "parsed_files", "claim_scope", "whole_project_semantics_complete", "inventory_entries", "unhandled_paths"],
      "properties": {
        "source_files": {"type": "integer", "minimum": 0},
        "parsed_files": {"type": "integer", "minimum": 0},
        "claim_scope": {"const": "syntax_and_explicit_manifest_declarations"},
        "whole_project_semantics_complete": {"const": false},
        "inventory_entries": {"type": "integer", "minimum": 0},
        "unhandled_paths": {"type": "array", "items": {"$ref": "#/$defs/unhandledPath"}}
      }
    },
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
    "inventory": {"type": "array", "items": {"$ref": "#/$defs/inventoryEntry"}},
    "semantic_fact_bundle": {"$ref": "#/$defs/fullBundle"},
    "semantic_validation": {"type": "object", "required": ["valid", "diagnostics"],
      "properties": {"valid": {"type": "boolean"}, "diagnostics": {"type": "array"}},
      "additionalProperties": true},
    "semantic_store": {"type": "object", "additionalProperties": false,
      "required": ["operationId", "state", "generation", "addedIds", "existingIds", "diagnostics"],
      "properties": {"operationId": {"type": "string", "minLength": 1},
        "state": {"enum": ["stored", "already_stored", "failed"]},
        "generation": {"type": "integer", "minimum": 0},
        "addedIds": {"type": "array", "items": {"type": "string"}},
        "existingIds": {"type": "array", "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "object"}}}}
  },
  "$defs": {
    "m1Bundle": {"type": "object", "additionalProperties": false,
      "required": ["version", "profile", "registrations", "assessments", "facts", "evidence", "coverage", "diagnostics"],
      "properties": {"version": {"const": "1.0.0"}, "profile": {"const": "m1-project-discovery-1"},
        "registrations": {"type": "array", "items": {"type": "object"}},
        "assessments": {"type": "array", "items": {"type": "object"}},
        "facts": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "array", "items": {"type": "object"}},
        "coverage": {"type": "array", "items": {"type": "object"}},
        "diagnostics": {"type": "array", "items": {"type": "object"}}}},
    "fullBundle": {"type": "object", "additionalProperties": false,
      "required": ["version", "profile", "registrations", "assessments", "facts", "evidence", "coverage", "dependencies", "dependencyResolutions", "semanticStates", "diagnostics", "contextDomains", "contexts"],
      "properties": {"version": {"const": "1.0.0"}, "profile": {"const": "semantic-fact-model-1"},
        "registrations": {"type": "array", "items": {"type": "object"}}, "assessments": {"type": "array", "items": {"type": "object"}},
        "facts": {"type": "array", "items": {"type": "object"}}, "evidence": {"type": "array", "items": {"type": "object"}},
        "coverage": {"type": "array", "items": {"type": "object"}}, "dependencies": {"type": "array", "items": {"type": "object"}},
        "dependencyResolutions": {"type": "array", "items": {"type": "object"}}, "semanticStates": {"type": "array", "items": {"type": "object"}},
        "diagnostics": {"type": "array", "items": {"type": "object"}}, "contextDomains": {"type": "array", "items": {"type": "object"}},
        "contexts": {"type": "array", "items": {"type": "object"}}}},
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject_id", "kind", "name", "path", "start_byte", "end_byte", "layer", "claim_mode", "text", "owner", "evidence_included"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subject_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0},
        "layer": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
        "claim_mode": {"enum": ["syntax", "documentation", "declaration", "cargo_metadata"]},
        "text": {"type": "string"},
        "owner": {"type": ["string", "null"]},
        "evidence_included": {"type": "boolean"}
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["selector", "reason"],
      "properties": {"selector": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
    },
    "inventoryEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "size_bytes", "state", "diagnostic"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["directory", "file", "symlink", "other"]},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "state": {"enum": ["readable", "unfollowed", "unreadable"]},
        "diagnostic": {"type": ["string", "null"]}
      }
    },
    "unhandledPath": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "state", "diagnostic", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["directory", "file", "symlink", "other"]},
        "state": {"enum": ["readable", "unfollowed", "unreadable"]},
        "diagnostic": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
